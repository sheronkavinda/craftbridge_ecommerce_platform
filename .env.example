APP_ENV=development
PORT=8080
DB_URL=postgres://postgres:postgres@localhost:5432/craftbridge?sslmode=disable
JWT_SECRET=replace-with-a-random-local-secret
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:4200

# Copy this file to backend/.env and configure an SMTP provider for reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:4200
